# Set by `npx convex dev` after choosing a development project.
VITE_CONVEX_URL=
# Set VITE_DEMO_MODE=true only for an explicitly local demo (never production).
VITE_DEMO_MODE=false
# Backend secrets live in the Convex deployment, not in this file:
#   CREDENTIALS_ENCRYPTION_KEY  32 random bytes, base64. Encrypts saved Aircraft
#     Spruce, FAA and Geoapify credentials (AES-GCM). `npm run setup:auth` creates
#     it, or: openssl rand -base64 32 | npx convex env set CREDENTIALS_ENCRYPTION_KEY
#     Never change or delete it in place; rotate with CREDENTIALS_ENCRYPTION_KEYS
#     and CREDENTIALS_ENCRYPTION_KEY_ID as in docs/runbooks/credentials-key.md.
#   RESEND_API_KEY / RESEND_FROM  Optional. Daily maintenance alert email digest
#     via Resend (RESEND_FROM is a verified sender, e.g. "Angel One <alerts@your-domain>").
#     Unset: email is skipped; in-app alerts still work.
#     npx convex env set RESEND_API_KEY re_... ; npx convex env set RESEND_FROM "..."
