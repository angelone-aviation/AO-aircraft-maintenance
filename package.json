{
  "name": "angel-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:backend": "convex dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint src convex tests scripts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev:demo": "VITE_DEMO_MODE=true vite --host 0.0.0.0",
    "dev:local": "CONVEX_AGENT_MODE=anonymous convex dev --local-backend-version precompiled-2026-09-28-5c7cb5b",
    "setup:auth": "node scripts/configure-auth.mjs",
    "setup:admin": "node scripts/bootstrap-admin.mjs",
    "test:local": "node scripts/smoke-local.mjs",
    "test:backup": "bash scripts/backup/nightly.test.sh",
    "check:standards": "node .claude/hooks/check-standards.mjs --changed-since origin/main",
    "backup:workbook": "node scripts/backup/records-workbook.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"convex/*.ts\" \"scripts/*.mjs\" \"tests/**/*.ts\" \"docs/*.md\" README.md package.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"convex/*.ts\" \"scripts/*.mjs\" \"tests/**/*.ts\" \"docs/*.md\" README.md package.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@fontsource/outfit": "^5.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^11.10.0",
    "@tanstack/react-router": "^1.170.46",
    "convex": "^1.49.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "oauth4webapi": "^3.8.8",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.10.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "convex-test": "^0.0.66",
    "exceljs": "4.4.0",
    "fake-indexeddb": "^6.2.7",
    "jose": "^6.2.15",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@sentry/bundler-plugins": {
      "glob": "^14.0.3"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "workbox-build": {
      "glob": "^14.0.3"
    }
  }
}
